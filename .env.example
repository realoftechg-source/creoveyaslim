# Copy this file to .env and fill in real values before running in production.

PORT=3000
NODE_ENV=production

# Long, random string used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Your Neon Postgres connection string (Neon dashboard -> Connection Details).
# Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Your permanent Decart API key. Never sent to the browser — the server
# exchanges it for a short-lived client token per broadcast session.
# Can also be set/overridden later from /admin_dashboard/settings.
DECART_API_KEY=

# Optional: enables auto-forwarding of Contact Us submissions to Telegram.
# Create a bot via @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=

# SMTP settings — power ALL outgoing email: welcome emails, payment
# approval/rejection emails, and the admin payment-notification email
# below. If SMTP_HOST is left blank, every email is safely skipped (never
# crashes anything) and just logged to the server console instead.
#
# Easiest real option: a Gmail account with an "App Password" (not your
# normal password — Google account settings -> Security -> 2-Step
# Verification -> App Passwords -> generate one for "Mail").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-email@gmail.com

# The email address that gets notified the moment a user submits a
# payment for review (so the admin doesn't have to keep the dashboard
# open all day to know one is waiting). Leave blank to disable.
ADMIN_NOTIFICATION_EMAIL=your-admin-inbox@example.com

# Bootstraps the very first admin account on first run only (if no admin
# exists yet). Change the password immediately after first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-immediately

# ---------------------------------------------------------------------------
# Public site address — used to build the password-reset links in emails.
# ---------------------------------------------------------------------------
APP_URL=https://creoveya.com

# ---------------------------------------------------------------------------
# "Continue with Google" (optional). Leave blank to hide the Google button.
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> "Web application". Add https://creoveya.com (and
# https://www.creoveya.com if you use it) under "Authorized JavaScript
# origins". No client secret is needed. Paste the Client ID here.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# "I'm not a robot" (optional upgrade). Out of the box the site uses a
# built-in checkbox + honeypot + rate limits, which needs no setup. For
# stronger protection create a free Cloudflare Turnstile widget
# (dash.cloudflare.com -> Turnstile) for creoveya.com and paste both keys;
# the site switches to Turnstile automatically.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
